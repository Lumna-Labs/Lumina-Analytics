DATABASE_URL=postgres://lumina:lumina@localhost:5432/lumina
HORIZON_URL=https://horizon.stellar.org
API_BIND=0.0.0.0:8080
POLL_INTERVAL_SECS=60
WHALE_THRESHOLD=10000

# Optional: response caching for hot read endpoints (/tvl, /pools, /tokens,
# /pools/trending). Leave unset to run with no cache (API falls back to
# Postgres for every request — correct, just slower under load).
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECS=15

# Optional: USD pricing. When enabled, lumina-ingest fetches XLM/USD from
# CoinGecko each cycle and derives a USD price for every asset reachable from
# native XLM through a chain of tracked classic-AMM pools (direct XLM pairs,
# plus assets only paired with an already-priced asset, up to a few hops).
# Off by default so local/offline dev stays deterministic and doesn't depend
# on an external API being reachable.
PRICE_FEED_ENABLED=false
COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price

# Optional: lending/liquidation ingestion for Blend pools on Soroban. Empty
# by default — there's no well-known "the pools" endpoint the way Horizon
# has for classic-network liquidity pools, so guessing contract addresses
# risks silently indexing the wrong (or stale) deployment. Populate with
# real, verified pool contract IDs (comma-separated) for your target network
# to turn this on; leaving it empty leaves the liquidations dashboard empty
# rather than showing invented risk numbers.
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
BLEND_POOL_IDS=

# Optional: USD prices for Blend reserve assets, keyed by Soroban Asset
# Contract address (not code/issuer — that's how Blend identifies reserves).
# Comma-separated `contract:price` pairs, e.g.
#   BLEND_ASSET_PRICES_USD=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA:1.00
# Populate with real, verified prices for your pool's reserves to turn on
# ltv/health_factor on the liquidations dashboard. This is a static,
# operator-supplied override, not a live feed — a wrong or stale price here
# would fabricate a risk number, so it's never fetched automatically.
BLEND_ASSET_PRICES_USD=

# Optional: alerting for outsized whale payments and lending positions that
# cross into a higher liquidation-risk band. Alerts are always recorded to
# the `alerts` table (visible on the dashboard's Alerts page) regardless of
# this setting; a webhook is just an additional delivery channel, off by
# default so this crate never calls out to a third party unprompted.
# Accepts a Slack-compatible incoming-webhook URL (POSTs `{"text": "..."}"`).
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=WARNING

# Minimum percent drop in a pool's total_shares between consecutive ingest
# cycles that's worth alerting on (kind "liquidity_drop"). Pool liquidity
# fluctuates constantly in normal operation, so this is deliberately a
# "sudden, large" threshold rather than firing on any decrease.
LIQUIDITY_DROP_THRESHOLD_PCT=30

# Minimum percent drop in a token's holder count (num_accounts) between
# consecutive ingest cycles that's worth alerting on (kind "holder_drop").
# Same "sudden, large" rationale as LIQUIDITY_DROP_THRESHOLD_PCT.
HOLDER_DROP_THRESHOLD_PCT=20

# Optional: per-client-IP rate limiting on the API (token bucket). 0 disables
# it entirely (the default) — this is a defensive measure for a publicly
# exposed deployment, not a correctness dependency.
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=40

# Optional: shared secret required (as an `X-Admin-Key` header) to create or
# delete alert rules/channels or watchlist items. Unset by default so
# local/dev needs no extra setup; set it before exposing the API beyond a
# trusted network, since those endpoints have no other access control.
ADMIN_API_KEY=
